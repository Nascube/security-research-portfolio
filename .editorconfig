# EditorConfig — https://editorconfig.org
# Applies consistent formatting across editors and CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Preserve intentional trailing spaces used for hard line breaks in Markdown.
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab
